# Copy this file to .env and replace both password placeholders for local development.
# Compose overrides DB_HOST with "db" inside the PHP container; 127.0.0.1 is for local PHP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=daw2_project_manager
DB_USER=daw2_app
DB_PASSWORD=change_this_development_password
DB_ROOT_PASSWORD=change_this_root_development_password
APP_PORT=8080
